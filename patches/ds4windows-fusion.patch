+    // Control-plane shutdown only. Keep TryRemove's immediate reentrant and
+    // cross-thread callback refusal intact, so a callback cannot wait on a stop
+    // that joins its own worker. Only an ordinary active callback is retried;
+    // all native, ownership and terminal-neutral failures remain fail-closed.
+    internal async System.Threading.Tasks.Task<(bool Removed,
+        Switch2RuntimeRegistrationTransactionFailure Failure)>
+        TryRemoveAfterCallbacksAsync(InputControllerSlotToken token,
+            int timeoutMilliseconds)
+    {
+        long deadline = Environment.TickCount64 + timeoutMilliseconds;
+        int remaining = timeoutMilliseconds;
+        while (true)
+        {
+            bool removed = core.TryRemove(token, remaining, out var failure);
+            if (removed || failure.Kind !=
+                    Switch2RuntimeRegistrationTransactionFailureKind.CallbackActive)
+                return (removed, failure);
+            remaining = (int)Math.Max(0L, deadline - Environment.TickCount64);
+            if (remaining == 0) return (false, failure);
+            await System.Threading.Tasks.Task.Delay(Math.Min(5, remaining)).
+                ConfigureAwait(false);
+            remaining = (int)Math.Max(0L, deadline - Environment.TickCount64);
+            if (remaining == 0) return (false, failure);
+        }
+    }
