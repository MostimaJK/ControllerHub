new file mode 100644
index 0000000..f3fc528
--- /dev/null
+++ b/DS4WindowsTests/FusionAudioFormatTests.cs
@@ -0,0 +1,46 @@
+using System.Buffers.Binary;
+using ControllerFusion.Input;
+using NAudio.Wave;
+
+namespace DS4WindowsTests;
+
+[TestClass]
+public sealed class FusionAudioFormatTests
+{
+    [TestMethod]
+    public void FourChannelEndpointRetainsItsExtensibleFormatAndChannelOrder()
+    {
+        var format=new WaveFormatExtensible(48000,32,4);
+        var output=FusionAudioFormat.ForEndpoint(new OneFrame(),format);
+        Assert.AreSame(format,output.WaveFormat,"WASAPI needs the endpoint's channel mask/subformat.");
+        var bytes=new byte[16];Assert.AreEqual(16,output.Read(bytes,0,bytes.Length));
+        CollectionAssert.AreEqual(new byte[8],bytes[..8]);
+        Assert.AreEqual(.25f,BinaryPrimitives.ReadSingleLittleEndian(bytes.AsSpan(8)));
+        Assert.AreEqual(-.25f,BinaryPrimitives.ReadSingleLittleEndian(bytes.AsSpan(12)));
+    }
+    [TestMethod]
+    public void Pcm16EndpointReceivesPcm16RatherThanFloatBytes()
+    {
+        var format=new WaveFormat(48000,16,4);
+        var output=FusionAudioFormat.ForEndpoint(new OneFrame(),format);
+        var bytes=new byte[8];Assert.AreEqual(8,output.Read(bytes,0,8));
+        Assert.AreSame(format,output.WaveFormat);
+        Assert.IsTrue(BinaryPrimitives.ReadInt16LittleEndian(bytes.AsSpan(4)) is >=8000 and <=8300);
+        Assert.IsTrue(BinaryPrimitives.ReadInt16LittleEndian(bytes.AsSpan(6)) is <=-8000 and >=-8300);
+    }
+    [TestMethod]
+    public void HapticAudioRejectsMismatchedChannelCounts()
+    {
+        Assert.ThrowsException<InvalidOperationException>(()=>FusionAudioFormat.ForEndpoint(new OneFrame(),new WaveFormat(48000,16,2)));
+    }
+    sealed class OneFrame:ISampleProvider
+    {
+        bool read;
+        public WaveFormat WaveFormat {get;}=WaveFormat.CreateIeeeFloatWaveFormat(48000,4);
+        public int Read(float[] buffer,int offset,int count)
+        {
+            if(read)return 0;read=true;
+            buffer[offset]=buffer[offset+1]=0;buffer[offset+2]=.25f;buffer[offset+3]=-.25f;return 4;
+        }
+    }
+}
diff --git a/DS4WindowsTests/FusionNativeWriteCompletionTests.cs b/DS4WindowsTests/FusionNativeWriteCompletionTests.cs
new file mode 100644
index 0000000..59dc814
--- /dev/null
+++ b/DS4WindowsTests/FusionNativeWriteCompletionTests.cs
@@ -0,0 +1,86 @@
+using System.IO;
+using System.IO.Pipes;
+using System.Runtime.InteropServices;
+using Microsoft.Win32.SafeHandles;
+using DS4Windows.Switch2;
+
+namespace DS4WindowsTests;
+
+[TestClass]
+public sealed class FusionNativeWriteCompletionTests
+{
+    [DllImport("kernel32.dll",CharSet=CharSet.Unicode,SetLastError=true)]
+    private static extern SafeFileHandle CreateFileW(string path,uint access,uint sharing,
+        IntPtr security,uint creation,uint flags,IntPtr template);
+
+    [TestMethod]
+    public void RealPendingWindowsWriteCanBeCancelledAndRetiredExactly()
+    {
+        // A local pipe with no reader provides real pending I/O without USB.
+        var name="Fusion-Cancel-"+Guid.NewGuid().ToString("N");
+        using var server=new NamedPipeServerStream(name,PipeDirection.In,1,
+            PipeTransmissionMode.Byte,PipeOptions.Asynchronous,4096,4096);
+        var connection=server.WaitForConnectionAsync();
+        using var file=CreateFileW(@"\\.\pipe\"+name,0x40000000,0,IntPtr.Zero,3,0x40000000,IntPtr.Zero);
+        Assert.IsFalse(file.IsInvalid);
+        Assert.IsTrue(connection.Wait(1000));
+        var bound=ThreadPoolBoundHandle.BindHandle(file);
+        var operation=new Switch2ProUsbWindowsOwnedFileWriteOperation(file,bound);
+        bool active=false;
+        try
+        {
+            Assert.IsTrue(operation.TryStart(new byte[1024*1024],0,1024*1024));active=true;
+            Assert.IsFalse(operation.TryWaitForNativeQuiescence(0),"Unread pipe should retain the write.");
+            Assert.IsTrue(operation.TryCancelExact());
+            Assert.IsTrue(operation.TryWaitForNativeQuiescence(1000),"Cancelled native write did not complete.");
+            Assert.IsTrue(operation.TryGetCompletion(out var completion));
+            Assert.AreNotEqual(1024*1024,completion.BytesTransferred);
+            operation.ReleaseSubmissionQuiesced();active=false;
+        }
+        finally
+        {
+            if(active)
+            {
+                operation.TryCancelExact();
+                if(operation.TryWaitForNativeQuiescence(2000))
+                {operation.ReleaseSubmissionQuiesced();active=false;}
+            }
+            if(!active){operation.DisposeOwnerQuiesced();bound.Dispose();}
+        }
+    }
+
+    [TestMethod]
+    public void RealWindowsOverlappedWritePublishesCompletionAndCanBeReused()
+    {
+        // Exercise the production WriteFile / IOCP operation against a private
+        // temporary file. No controller, driver, device discovery or USB is used.
+        var path=Path.Combine(Path.GetTempPath(),"Fusion-Iocp-"+Guid.NewGuid().ToString("N")+".bin");
+        using var file=CreateFileW(path,0xC0000000,3,IntPtr.Zero,1,0x44000000,IntPtr.Zero);
+        Assert.IsFalse(file.IsInvalid);
+        var bound=ThreadPoolBoundHandle.BindHandle(file);
+        var operation=new Switch2ProUsbWindowsOwnedFileWriteOperation(file,bound);
+        bool active=false;
+        try
+        {
+            var bytes=Enumerable.Range(0,64).Select(i=>(byte)i).ToArray();
+            for(int iteration=0;iteration<10;iteration++)
+            {
+                Assert.IsTrue(operation.TryStart(bytes,0,bytes.Length));active=true;
+                Assert.IsTrue(operation.TryWaitForNativeQuiescence(1000),"Actual IOCP completion was not published.");
+                Assert.IsTrue(operation.TryGetCompletion(out var completion));
+                Assert.AreEqual(64,completion.BytesTransferred);
+                operation.ReleaseSubmissionQuiesced();active=false;
+            }
+        }
+        finally
+        {
+            if(active)
+            {
+                operation.TryCancelExact();
+                if(operation.TryWaitForNativeQuiescence(2000))
+                {operation.ReleaseSubmissionQuiesced();active=false;}
+            }
+            if(!active){operation.DisposeOwnerQuiesced();bound.Dispose();}
+        }
+    }
+}
