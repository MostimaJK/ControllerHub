+using ControllerFusion.Input;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+namespace DS4WindowsTests;
+[TestClass,DoNotParallelize]
+public class FusionShutdownOutcomeTests
+{
+    [TestMethod]
+    public void FailedShutdownRetainsFacadeOwnershipUntilConfirmedCompletion()
+    {
+        bool allow=false;var previous=FusionInput.Current;
+        var input=new FusionInput(()=>allow);FusionInput.Current=input;
+        try
+        {
+            Assert.ThrowsException<System.IO.IOException>(input.Dispose);
+            Assert.AreSame(input,FusionInput.Current);
+            allow=true;input.Dispose();Assert.IsNull(FusionInput.Current);
+        }
+        finally {allow=true;input.Dispose();FusionInput.Current=previous;}
+    }
+}
